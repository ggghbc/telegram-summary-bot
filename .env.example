# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================

# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Base URL for Telegram Bot API (default: https://api.telegram.org)
# Change only if using a custom local Telegram Bot API server
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Optional HTTP/SOCKS proxy (e.g., socks5h://127.0.0.1:10808 or http://proxy:8080)
PROXY_URL=

# ==============================================================================
# LLM Provider Configuration (OpenAI, Gemini, Groq, DeepSeek, Ollama, etc.)
# ==============================================================================

# LLM API Key
LLM_API_KEY=your_llm_api_key_here

# LLM API Endpoint URL
# Default OpenAI: https://api.openai.com/v1/chat/completions
# Google Gemini (OpenAI format): https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Groq (Ultra fast): https://api.groq.com/openai/v1/chat/completions
# DeepSeek: https://api.deepseek.com/chat/completions
# OpenRouter: https://openrouter.ai/api/v1/chat/completions
# Local Ollama: http://localhost:11434/v1/chat/completions
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Model name:
# OpenAI: gpt-4o-mini, gpt-4o
# Gemini: gemini-3.8-flash
# Groq: llama-3.3-70b-versatile
# DeepSeek: deepseek-chat
LLM_MODEL=gpt-4o-mini

# Model temperature (0.0 to 1.0, lower means more concise & focused)
LLM_TEMPERATURE=0.4

# Request timeout in seconds for LLM call
LLM_TIMEOUT_SECONDS=120

# ==============================================================================
# Bot & Storage Limits
# ==============================================================================

# Maximum number of messages allowed per summary request (hard cap: 1500)
MAX_MESSAGES_TO_PROCESS=1500

# Default number of messages if user triggers bot without a number
DEFAULT_MESSAGES_TO_PROCESS=100

# Maximum recent messages to retain in database per chat
MAX_STORED_MESSAGES_PER_CHAT=3000

# Restrict summary requests exclusively to chat administrators
ADMIN_ONLY_SUMMARIES=false

# Cooldown between summary generation calls per chat (in seconds)
RATE_LIMIT_SECONDS=30

# Enable automated multimodal vision analysis for images and photos
ENABLE_IMAGE_ANALYSIS=true

# SQLite database file path
DB_PATH=messages.db


